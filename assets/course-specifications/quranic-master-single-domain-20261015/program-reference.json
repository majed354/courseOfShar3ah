  "program_outcomes": [
    {
      "program": "ماجستير في الدراسات القرآنية المعاصرة",
      "code": "ع1",
      "text": "أن يحلل الأصول والنظريات والمناهج المتعلقة بالتفسير، ويبين تطورها التاريخي واتجاهاتها المعاصرة.",
      "source_file": "assets/course-specifications/quranic-master-single-domain-20261015/program-specification.pdf",
      "source_page": 4,
      "confidence": 1.0
    },
    {
      "program": "ماجستير في الدراسات القرآنية المعاصرة",
      "code": "ع2",
      "text": "أن يشرح مباحث علوم القرآن المختلفة، ويقيم توظيفها التكاملي مع العلوم الشرعية واللغوية والإنسانية في تفسير النص القرآني ومعالجة قضايا الواقع.",
      "source_file": "assets/course-specifications/quranic-master-single-domain-20261015/program-specification.pdf",
      "source_page": 4,
      "confidence": 1.0
    },
    {
      "program": "ماجستير في الدراسات القرآنية المعاصرة",
      "code": "ع3",
      "text": "أن يحلل مصادر الدراسات القرآنية التراثية والمعاصرة، التقليدية والرقمية، ويقيم مناهجها وموثوقيتها وإمكانات الإفادة منها في البحث العلمي.",
      "source_file": "assets/course-specifications/quranic-master-single-domain-20261015/program-specification.pdf",
      "source_page": 4,
      "confidence": 1.0
    },
    {
      "program": "ماجستير في الدراسات القرآنية المعاصرة",
      "code": "م1",
      "text": "أن يطبق مناهج التفسير المختلفة ومهارات التحليل والنقد في تفسير النصوص القرآنية.",
      "source_file": "assets/course-specifications/quranic-master-single-domain-20261015/program-specification.pdf",
      "source_page": 4,
      "confidence": 1.0
    },
    {
      "program": "ماجستير في الدراسات القرآنية المعاصرة",
      "code": "م2",
      "text": "أن يصمم بحوثًا أصيلة في الدراسات القرآنية المعاصرة، موظفًا مناهج البحث وتحقيق المخطوطات والتقنيات الرقمية في جمع البيانات وتحليلها.",
      "source_file": "assets/course-specifications/quranic-master-single-domain-20261015/program-specification.pdf",
      "source_page": 4,
      "confidence": 1.0
    },
    {
      "program": "ماجستير في الدراسات القرآنية المعاصرة",
      "code": "ق1",
      "text": "أن يلتزم بالقيم الإسلامية والأخلاقيات البحثية والمعايير العلمية في التعامل مع النص القرآني، ومع إنتاج الباحثين الآخرين، وفي استخدام التقنيات المعاصرة.",
      "source_file": "assets/course-specifications/quranic-master-single-domain-20261015/program-specification.pdf",
      "source_page": 4,
      "confidence": 1.0
    },
    {
      "program": "ماجستير في الدراسات القرآنية المعاصرة",
      "code": "ق2",
      "text": "أن يتحمل المسؤولية والاستقلالية في تطوير مساره العلمي والمهني في الدراسات القرآنية المعاصرة، ويشارك بفاعلية وبروح قيادية في مشروعات بحثية متقدمة.",
      "source_file": "assets/course-specifications/quranic-master-single-domain-20261015/program-specification.pdf",
