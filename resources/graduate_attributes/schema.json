{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:local:taif:graduate-attributes:v1",
  "title": "Taif graduate attributes by program specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "institutional_source", "programs"],
  "properties": {
    "schema_version": {"const": "taif-graduate-attributes-v1"},
    "institutional_source": {"$ref": "#/$defs/source"},
    "programs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/program"}}
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "page", "sha256", "url"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "page": {"type": ["integer", "null"], "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "url": {"type": "string"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["university", "college", "department", "degree", "program_code", "plan_type", "plan_version", "specification_sha256"],
      "properties": {
        "university": {"type": "string"}, "college": {"type": "string"},
        "department": {"type": "string"}, "degree": {"type": "string"},
        "program_code": {"type": "string"}, "plan_type": {"type": "string"},
        "plan_version": {"type": "string"},
        "specification_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "measurement": {
      "type": "object", "additionalProperties": false,
      "required": ["direct", "indirect", "status", "source_page"],
      "properties": {
        "direct": {"type": "string", "minLength": 1},
        "indirect": {"type": "string", "minLength": 1},
        "status": {"enum": ["official_guidance", "proposal"]},
        "source_page": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "attribute": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "name", "kind", "definition", "text_status", "approval_status", "confidence", "evidence", "measurement"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["institutional", "specialty"]},
        "definition": {"type": "string", "minLength": 1},
        "text_status": {"enum": ["operational_summary_of_official_text", "editorial_proposal_from_plo"]},
        "approval_status": {"enum": ["institutional_official", "committee_review_required"]},
        "confidence": {"enum": ["high", "medium", "low"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "measurement": {"$ref": "#/$defs/measurement"}
      }
    },
    "alignment": {
      "type": "object", "additionalProperties": false,
      "required": ["plo_code", "plo_text", "plo_confidence", "attribute_codes", "status", "evidence"],
      "properties": {
        "plo_code": {"type": "string", "minLength": 1},
        "plo_text": {"type": "string"},
        "plo_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "attribute_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["proposed_from_plo", "unmapped_review_required"]},
        "evidence": {"$ref": "#/$defs/source"}
      }
    },
    "program": {
      "type": "object", "additionalProperties": false,
      "required": ["program_key", "program_name", "identity", "specification", "specification_approval_status", "review_context", "attributes", "plo_alignment", "extraction_issues", "committee_approval", "progress"],
      "properties": {
        "program_key": {"type": "string", "minLength": 1},
        "program_name": {"type": "string", "minLength": 1},
        "identity": {"$ref": "#/$defs/identity"},
        "specification": {"$ref": "#/$defs/source"},
        "specification_approval_status": {"type": "string"},
        "review_context": {
          "type": "object", "additionalProperties": false,
          "required": ["mission_goals", "academic_professional_standards", "profession_needs"],
          "properties": {
            "mission_goals": {"type": "string"},
            "academic_professional_standards": {"type": "string"},
            "profession_needs": {"type": "string"}
          }
        },
        "attributes": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/attribute"}},
        "plo_alignment": {"type": "array", "items": {"$ref": "#/$defs/alignment"}},
        "extraction_issues": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["plo_code", "text", "source_page", "reason"],
            "properties": {
              "plo_code": {"type": "string"}, "text": {"type": "string"},
              "source_page": {"type": ["integer", "null"], "minimum": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        },
        "committee_approval": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "reference", "date"],
          "properties": {
            "status": {"enum": ["pending", "approved"]},
            "reference": {"type": "string"}, "date": {"type": "string"}
          }
        },
        "progress": {"enum": ["mapped_for_review", "specification_extraction_required"]}
      }
    }
  }
}
